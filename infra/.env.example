# 复制为 .env 后填值；.env 不入库。
# 全集与默认值见 docs/01-architecture/config.md
# 本文件只列 momo-infra（momoctl）直接消费的键。

# ===== 通用 =====
MOMO_ENV=dev
MOMO_LOG_LEVEL=warn
MOMO_LOG_FORMAT=pretty             # pretty | json
MOMO_PROFILE=normal                # normal | degraded（doctor 校验矩阵、serve 组件表按此选档）
MOMO_MODELS_DIR=~/.cache/momo/models   # 权重根目录，镜像 <owner>/<repo> 布局 + models.lock

# ===== 端点（doctor endpoints 组探活对象 / serve 组件表输入） =====
MOMO_ORCH_LISTEN=127.0.0.1:7800    # momod /healthz
MOMO_LLM_ENDPOINT=http://mac-studio:7820/v1   # 大脑 OpenAI 端点；degraded 改 127.0.0.1 或 api.deepseek.com
MOMO_LLM_MODEL=qwen3-30b-a3b-4bit
MOMO_LLM_API_KEY=                  # 敏感：仅设/未设会被 doctor 检查，不回显；DeepSeek 档必填
MOMO_ASR_ENDPOINT=ws://127.0.0.1:7810/ws
MOMO_TTS_ENDPOINT=ws://127.0.0.1:7811/ws
MOMO_ASR_LISTEN=127.0.0.1:7810     # momo-svc-asr /healthz
MOMO_TTS_LISTEN=127.0.0.1:7811     # momo-svc-tts /healthz

# ===== 大脑启停（degraded 本地 llama-server 用） =====
MOMO_BRAIN_BACKEND=mlx             # mlx | vllm | deepseek | local
MOMO_BRAIN_MODEL_PATH=~/models/Qwen3-8B-4bit   # degraded 指 GGUF（如 Qwen/Qwen3-8B-GGUF 内 *.gguf）
MOMO_BRAIN_PORT=7820

# ===== 敏感（doctor 只查是否设置） =====
MOMO_WEB_TOKEN=                    # 敏感：momoctl web --listen 放宽出 localhost 时必填

# ===== 上游直通（非 MOMO_ 前缀；infra 拉起 python 服务前注入子进程） =====
HF_ENDPOINT=https://hf-mirror.com  # laptop 必须（huggingface.co 不通，ADR-017）
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# HTTPS_PROXY=

# ===== 档位切换 =====
# momoctl switch --to normal|degraded 把 .env 符号链接重指到
# .env.normal / .env.degraded（两文件 gitignore，不在本模板内）。
