# 复制为 .env 后填值；.env 不入库。
# 全集与默认值见 docs/01-architecture/config.md（本文件只含 momo-models 读取的键）

# 通用
MOMO_ENV=dev
MOMO_LOG_LEVEL=info
MOMO_LOG_FORMAT=pretty         # pretty | json
MOMO_MODELS_DIR=~/.cache/momo/models

# ASR（momo-svc-asr）
MOMO_ASR_LISTEN=127.0.0.1:7810
MOMO_ASR_PROVIDER=sensevoice   # sensevoice；云端实现注册后同级可选
MOMO_ASR_MODEL=sense-voice-small-int8   # MANIFEST 条目名（其 dest 即模型目录）
MOMO_ASR_THREADS=4
MOMO_VAD_PROVIDER=silero     # silero
MOMO_VAD_SILENCE_MS=250

# TTS（momo-svc-tts）
MOMO_TTS_LISTEN=127.0.0.1:7811
MOMO_TTS_PROVIDER=kokoro       # edge | kokoro | f5 | cosyvoice3 | sovits
MOMO_TTS_DEVICE=cuda           # cuda | cpu | mps
MOMO_TTS_VOICE=                # 音色名（edge=zh-CN-XiaoxiaoNeural 等；空=按 MOMO_TTS_LANG 默认）
MOMO_TTS_VOICE_REF=            # 克隆用参考音频路径
MOMO_TTS_MODEL_DIR=            # SFT 克隆产物目录（灰度切换/回滚）
MOMO_TTS_LANG=auto
MOMO_COSYVOICE3_HOME=          # FunAudioLLM/CosyVoice 源码 checkout（官方推理栈）
MOMO_COSYVOICE3_PYTHON=        # cosyvoice3 隔离 venv/conda 解释器

# embed（momo-svc-embed，记忆检索）
MOMO_EMBED_LISTEN=127.0.0.1:7812
MOMO_MEMORY_ENABLED=false
MOMO_MEMORY_DB=data/momo.vec.db

# 视觉（下沉到 models 时启用）
MOMO_VISION_ENDPOINT=https://api.deepseek.com/v1
MOMO_VISION_MODEL=deepseek-v4-flash-vision-exp
MOMO_VISION_API_KEY=         # 敏感：视觉 provider key

# 上游直通（非 MOMO_ 前缀）
HF_ENDPOINT=https://hf-mirror.com   # laptop 必须（huggingface.co 不通）
# UV_INDEX_URL=                    # uv/pip 镜像，仅安装期生效
# HTTPS_PROXY=
